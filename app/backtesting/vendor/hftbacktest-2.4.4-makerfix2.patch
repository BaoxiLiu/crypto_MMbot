+            // Account every newly acknowledged maker execution, including partial fills.
+            // Rejected requests can echo an earlier fill and must never apply it again.
+            if order.req != Status::Rejected
+                && matches!(order.status, Status::Filled | Status::PartiallyFilled)
+            {
+                let accounted_qty = self.orders.get(&order.order_id)
+                    .map_or(0.0, |known| known.qty - known.leaves_qty);
+                let newly_filled = order.qty - order.leaves_qty - accounted_qty;
+                if order.maker && newly_filled > 0.0 {
+                    let mut execution = order.clone();
+                    execution.exec_qty = newly_filled;
+                    self.state.apply_fill(&execution);
+                } else if !order.maker && order.status == Status::Filled {
+                    // Preserve upstream taker behavior; this patch targets resting maker fills.
+                    self.state.apply_fill(&order);
+                }
             }
