{
  "schema_version": 1,
  "library_version": "1.0.0",
  "frozen_baseline": "app/prediction/schema.py FACTOR_NAMES (50 unchanged)",
  "factor_status": "sample_validated",
  "adoption": "none; no predictive or economic validation",
  "parameters": {
    "quota_usdc": 10000,
    "near_ticks": 2,
    "retention_seconds": 60,
    "bucket_count": 20,
    "max_events": 200000,
    "book_stale_ms": 3000
  },
  "clock": "source received_time int64 nanoseconds; source-specific, no synthetic latency correction",
  "window_boundary": "(t-L,t], exact retention boundary retained; no cross-gap or snapshot window carry",
  "input_contract": "atomically grouped depth messages with U/u/pu; valid consecutive trade IDs; placeholder excluded without skipping ID",
  "denominator_rule": "nonpositive/missing denominator => NaN; valid no-event rates after complete warmup => 0",
  "group_order": "source nanosecond receipt order; if timestamps tie, replay uses depth before trade, documented observational ordering",
  "geometry": "near range uses abs(price_index - pre-message best_index)<=2; no duplicate level keys per atomic update",
  "complexity": "heap book updates O(log levels), bounded 60s event deques; query O(retained events), no claim of O(1)",
  "stale_policy": "S01-S05/S16 unavailable if depth receipt age>3s; S14/S15 unavailable if completed bucket age>60s; absent quota => NaN",
  "factors": [
    {
      "id": "S01",
      "name": "depth_message_rate_1s",
      "unit": "消息/s",
      "formula": "完整增量消息数/1s",
      "history": "1s",
      "overlap_note": "A7数价位行，本项数完整消息",
      "version": "1.0.0",
      "source": "flow.py",
      "status": "sample_validated",
      "predictive_status": "not_evaluated"
    },
    {
      "id": "S02",
      "name": "near_bid_net_add_rate_1s",
      "unit": "USDC/s",
      "formula": "Σp max(Δq,0)，买侧、距消息前最优价≤2ticks",
      "history": "1s",
      "overlap_note": "补近端净增加",
      "version": "1.0.0",
      "source": "flow.py",
      "status": "sample_validated",
      "predictive_status": "not_evaluated"
    },
    {
      "id": "S03",
      "name": "near_ask_net_add_rate_1s",
      "unit": "USDC/s",
      "formula": "同S02，卖侧",
      "history": "1s",
      "overlap_note": "补近端净增加",
      "version": "1.0.0",
      "source": "flow.py",
      "status": "sample_validated",
      "predictive_status": "not_evaluated"
    },
    {
      "id": "S04",
      "name": "near_bid_net_decrease_rate_1s",
      "unit": "USDC/s",
      "formula": "Σp max(-Δq,0)，买侧、距消息前最优价≤2ticks",
      "history": "1s",
      "overlap_note": "B1为30s全簿，本项近端1s",
      "version": "1.0.0",
      "source": "flow.py",
      "status": "sample_validated",
      "predictive_status": "not_evaluated"
    },
    {
      "id": "S05",
      "name": "near_ask_net_decrease_rate_1s",
      "unit": "USDC/s",
      "formula": "同S04，卖侧",
      "history": "1s",
      "overlap_note": "B2为30s全簿，本项近端1s",
      "version": "1.0.0",
      "source": "flow.py",
      "status": "sample_validated",
      "predictive_status": "not_evaluated"
    },
    {
      "id": "S06",
      "name": "buy_notional_rate_1s",
      "unit": "USDC/s",
      "formula": "Σ主动买成交名义额/1s",
      "history": "1s",
      "overlap_note": "已有buy_qty与流比例，本项绝对名义额流速",
      "version": "1.0.0",
      "source": "flow.py",
      "status": "sample_validated",
      "predictive_status": "not_evaluated"
    },
    {
      "id": "S07",
      "name": "sell_notional_rate_1s",
      "unit": "USDC/s",
      "formula": "Σ主动卖成交名义额/1s",
      "history": "1s",
      "overlap_note": "同S06",
      "version": "1.0.0",
      "source": "flow.py",
      "status": "sample_validated",
      "predictive_status": "not_evaluated"
    },
    {
      "id": "S08",
      "name": "notional_acceleration_0p5s_5s",
      "unit": "ratio",
      "formula": "(0.5s成交额/0.5)/(5s成交额/5)",
      "history": "5s",
      "overlap_note": "C8是流向不平衡变化，本项总流量加速度",
      "version": "1.0.0",
      "source": "flow.py",
      "status": "sample_validated",
      "predictive_status": "not_evaluated"
    },
    {
      "id": "S09",
      "name": "last_valid_trade_age_ms",
      "unit": "ms",
      "formula": "决策时间减最近有效成交接收时间",
      "history": "since last valid trade",
      "overlap_note": "成交稀疏/空窗状态",
      "version": "1.0.0",
      "source": "flow.py",
      "status": "sample_validated",
      "predictive_status": "not_evaluated"
    },
    {
      "id": "S10",
      "name": "trade_interval_cv_5s",
      "unit": "ratio",
      "formula": "5s内有效成交接收间隔总体标准差/均值",
      "history": "5s",
      "overlap_note": "至少3笔且均值>0",
      "version": "1.0.0",
      "source": "flow.py",
      "status": "sample_validated",
      "predictive_status": "not_evaluated"
    },
    {
      "id": "S11",
      "name": "trailing_quota_duration_all_ms",
      "unit": "ms",
      "formula": "向后累计成交额首次达到Q，决策时间减边界成交接收时间",
      "history": "≤60s",
      "overlap_note": "完整大单边界，不插值",
      "version": "1.0.0",
      "source": "flow.py",
      "status": "sample_validated",
      "predictive_status": "not_evaluated"
    },
    {
      "id": "S12",
      "name": "trailing_quota_duration_buy_ms",
      "unit": "ms",
      "formula": "同S11，仅主动买",
      "history": "≤60s",
      "overlap_note": "方向量时钟",
      "version": "1.0.0",
      "source": "flow.py",
      "status": "sample_validated",
      "predictive_status": "not_evaluated"
    },
    {
      "id": "S13",
      "name": "trailing_quota_duration_sell_ms",
      "unit": "ms",
      "formula": "同S11，仅主动卖",
      "history": "≤60s",
      "overlap_note": "方向量时钟",
      "version": "1.0.0",
      "source": "flow.py",
      "status": "sample_validated",
      "predictive_status": "not_evaluated"
    },
    {
      "id": "S14",
      "name": "equal_notional_bucket_abs_imbalance",
      "unit": "ratio",
      "formula": "最近20个完成的Q桶平均|buy-sell|/Q",
      "history": "20 buckets",
      "overlap_note": "C9是时间桶代理；本项完成等额桶",
      "version": "1.0.0",
      "source": "flow.py",
      "status": "sample_validated",
      "predictive_status": "not_evaluated"
    },
    {
      "id": "S15",
      "name": "last_completed_volume_bucket_duration_ms",
      "unit": "ms",
      "formula": "最后完成Q桶的末笔时间减上一桶结束时间；首桶从首筆时间开始",
      "history": "last completed bucket",
      "overlap_note": "同毫秒多桶可为0，不求倒数",
      "version": "1.0.0",
      "source": "flow.py",
      "status": "sample_validated",
      "predictive_status": "not_evaluated"
    },
    {
      "id": "S16",
      "name": "near_depth_depletion_asymmetry_1s",
      "unit": "1/s",
      "formula": "S04/当前近端买深度名义额-S05/当前近端卖深度名义额",
      "history": "1s",
      "overlap_note": "方向化流动性净下降压力，非真实撤单毒性概率",
      "version": "1.0.0",
      "source": "flow.py",
      "status": "sample_validated",
      "predictive_status": "not_evaluated"
    }
  ],
  "parameter_policy": "Q=max(1USDC,median of 60 complete-minute notional totals / 5), fitted strictly earlier; refit inside training folds before predictive evaluation",
  "validation": {
    "unit_tests": 20,
    "real_symbols": 13,
    "real_window_utc": "2026-10-01 01:00–02:00",
    "scope": "calculation, causality and real-feed sample only",
    "report": "doc/factors/flow-v1/validation.json"
  },
